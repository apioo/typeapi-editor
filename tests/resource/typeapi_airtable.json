  "definitions": {
    "Create_Record_Request": {
      "description": "Payload used to create new records in a table.",
      "type": "struct",
      "properties": {
        "records": {
          "description": "Array of record objects to create.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Record"
          }
        },
        "typecast": {
          "description": "Automatic data conversion option.",
          "type": "boolean"
        },
        "returnFieldsByFieldId": {
          "description": "Return field names keyed by field ID.",
          "type": "boolean"
        }
      }
    },
    "Perform_Upsert": {
      "description": "Configuration for upsert behaviour.",
      "type": "struct",
      "properties": {
        "fieldsToMergeOn": {
          "description": "Fields used to target records for upsert.",
          "type": "array",
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "Bulk_Update_Request": {
      "description": "Payload for updating or upserting multiple records.",
      "type": "struct",
      "properties": {
        "performUpsert": {
          "description": "Upsert options configuration.",
          "type": "reference",
          "target": "Perform_Upsert"
        },
        "returnFieldsByFieldId": {
          "description": "Return field names keyed by field ID.",
          "type": "boolean"
        },
        "typecast": {
          "description": "Automatic data conversion option.",
          "type": "boolean"
        },
        "records": {
          "description": "Array of records to update.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Record"
          }
        }
      }
    },
    "Bulk_Update_Response": {
      "description": "Response container for bulk update or upsert operations.",
      "type": "struct",
      "properties": {
        "createdRecords": {
          "description": "List of record IDs created during upsert.",
          "type": "array",
          "schema": {
            "type": "string"
          }
        },
        "updatedRecords": {
          "description": "List of record IDs updated.",
          "type": "array",
          "schema": {
            "type": "string"
          }
        },
        "records": {
          "description": "The updated/created record objects.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Record"
          }
        }
      }
    },
    "Comment": {
      "description": "Represents a comment attached to a record.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "Unique identifier of the comment.",
          "type": "string"
        },
        "createdTime": {
          "description": "Timestamp when the comment was created.",
          "type": "string",
          "format": "date-time"
        },
        "lastUpdatedTime": {
          "description": "Timestamp when the comment was last updated.",
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "description": "The comment text content.",
          "type": "string"
        },
        "parentCommentId": {
          "description": "ID of parent comment if threaded.",
          "type": "string"
        },
        "reactions": {
          "description": "List of user reactions on the comment.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Comment_Reaction"
          }
        },
        "author": {
          "description": "User who created the comment.",
          "type": "reference",
          "target": "Comment_Author"
        }
      }
    },
    "Comment_Author": {
      "description": "Author metadata for a comment.",
      "type": "struct",
      "properties": {
        "id": {
          "description": "User ID of the author.",
          "type": "string"
        },
        "email": {
          "description": "Email address of the author.",
          "type": "string"
        },
        "name": {
          "description": "Display name of the author.",
          "type": "string"
        }
      }
    },
    "Comment_Collection": {
      "description": "Collection of record comments.",
      "type": "struct",
      "properties": {
        "offset": {
          "description": "Pagination offset string.",
          "type": "string"
        },
        "comments": {
          "description": "List of comments.",
          "type": "array",
          "schema": {
            "type": "reference",
            "target": "Comment"
          }
        }
      }
    },
    "Comment_Reaction": {
      "description": "User reaction to a comment.",
      "type": "struct",
      "properties": {
        "emoji": {
          "description": "Emoji identifier for the reaction.",
          "type": "string"
        },
        "reactingUser": {
          "description": "User who left the reaction.",
          "type": "reference",
          "target": "Comment_Author"
        }
      }
    },
    "Delete_Response": {
      "description": "Response structure for deletion operations.",
      "type": "struct",
      "properties": {
        "deleted": {
          "description": "Indicates whether the entity was deleted successfully.",
          "type": "boolean"
        },
        "id": {
          "description": "Identifier of the deleted entity.",
          "type": "string"
        }
      }
    },
    "Error": {
      "description": "Top-level error response wrapper.",
      "type": "struct",
      "properties": {
        "error": {
          "description": "Error details payload.",
          "type": "reference",
          "target": "Error_Details"
        }
      }
    },
    "Error_Details": {
